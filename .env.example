# Pumper — environment template. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way: it is the only place real
# credentials live in this checkout. This file carries NAMES and placeholders
# only — never paste a real value here.
#
# How it is loaded: `load_dotenv()` in crates/server/src/main.rs is a hand-rolled,
# non-clobbering `KEY=VALUE` reader — it runs once at startup, skips blank/`#`
# lines, strips surrounding quotes, and only sets a variable that is NOT already
# in the process environment. The real environment always wins over this file.
# It reads `./.env` relative to the working directory, so run the server from the
# repo root. Only the `pumper` server binary loads it; the `reindex` /
# `search-backfill` maintenance binaries do not.
#
# set per environment: local .env / CI secrets / host dashboard

# --- credentials -------------------------------------------------------------

# Free US Census Bureau API key. Read by crates/apps/census-common/src/lib.rs:30
# (falls back to `params.api_key`), and declared as a hard readiness requirement
# by the census apps — `Requirement::Env("CENSUS_API_KEY")` in
# crates/apps/census-density/src/lib.rs:72 and
# crates/apps/census-nonemp/src/lib.rs:68 — so `GET /apps` reports those apps as
# not-ready until it is set. Sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Bearer token for the DataHub GMS metadata emitter. Read by
# DatahubConfig::resolve_token (crates/core/src/config.rs:144) as the fallback
# when `[datahub] token` is absent/empty in config.toml. Leave empty when
# `[datahub] enabled = false` (the default).
DATAHUB_TOKEN=

# --- paths / identity --------------------------------------------------------

# Path to the TOML config file. Read by Config::load
# (crates/core/src/config.rs:203). Default when unset: `config.toml`. A missing
# file is a warning, not an error — defaults are baked into the binary.
# PUMPER_CONFIG=config.toml

# Path to the data-source catalog. Read by Catalog::load
# (crates/core/src/catalog.rs:93). Default when unset:
# `catalog/data-sources.toml`. A missing file yields an empty catalog; a
# malformed one is a hard error.
# PUMPER_CATALOG=catalog/data-sources.toml

# Build identity stamped on every extraction-health run row, so a fleet-wide
# break correlates with a deploy. Read by build_id() in
# crates/core/src/app.rs:466. Default when unset: the crate version. Set this to
# the commit sha in CI / on a release build.
# PUMPER_BUILD_ID=

# --- logging -----------------------------------------------------------------

# tracing-subscriber filter directive, read via `EnvFilter::try_from_default_env`
# (crates/server/src/main.rs:25). Default when unset: `info`.
# RUST_LOG=info
