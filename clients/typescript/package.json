{
  "name": "@pumper/sync",
  "version": "0.1.0",
  "description": "Shared consumer SDK for Pumper's canonical datasets — incremental, watermark-driven mirroring into any product store.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json && node -e \"require('fs').cpSync('test/fixtures','dist-test/test/fixtures',{recursive:true})\"",
    "test": "node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
