#!/bin/sh
# commit-msg — conventional-commit shape, enforced instead of merely observed.
#
# This repo's history already follows the convention (`fix(api-surface): ...`,
# `chore: ...`, `deps: ...`) with nothing enforcing it, which is the state where
# a convention decays one hurried commit at a time. It matters more here than in
# most repos: `.github/dependabot.yml` sets `commit-message.prefix` for both
# ecosystems, `just flake-report` and the lane history are read as sequences of
# commits, and the changelog a release tag implies is only as good as the
# subjects it is built from.
#
# Deliberately no commitlint: that is a Node toolchain, a config file and a
# lockfile to keep current, for a regex. The types below are the ones this
# history actually uses plus the standard set.
#
# Escape hatches: PUMPER_SKIP_HOOKS=1, or `git commit --no-verify`.

set -e

if [ -n "$PUMPER_SKIP_HOOKS" ]; then
    exit 0
fi

MSG_FILE="$1"
# The subject: first line, ignoring the comment block git appends.
SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed -n '1p')

# A merge, revert, fixup or squash subject is generated by git itself; rejecting
# those would block `git revert` and interactive rebase for no benefit.
case "$SUBJECT" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

# Empty subject: git aborts the commit on its own, and a message here would only
# be noise on top of that.
[ -z "$SUBJECT" ] && exit 0

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|deps'

if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+"; then
    cat >&2 <<EOF

commit-msg: BLOCKED — the subject is not a conventional commit.

  got:      $SUBJECT
  expected: <type>[(scope)][!]: <description>
  types:    $(printf '%s' "$TYPES" | tr '|' ' ')

  examples: fix(api-surface): render the OpenAPI document once, not per request
            feat(crawl): add in-degree derivation over crawl/edges
            deps: bump the cargo minor/patch group

  bypass:   PUMPER_SKIP_HOOKS=1 git commit ...
EOF
    exit 1
fi

# 72 is the width `git log --oneline` and every GitHub view truncate at. A
# warning, not a block: a long subject is a readability cost, not a correctness
# one, and blocking on it is how a hook earns a permanent --no-verify.
LEN=$(printf '%s' "$SUBJECT" | wc -c | tr -d ' ')
if [ "$LEN" -gt 72 ]; then
    echo "commit-msg: note — subject is ${LEN} chars; it will be truncated at 72 in most views." >&2
fi

exit 0
